{
  "name": "blogs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/blogs/src",
  "tags": ["type:app", "scope:blogs"],
  "targets": {
    "prebuild": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/blogs/scripts/content.mjs"
      }
    },
    "prebuild:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/blogs/scripts/content.mjs --drafts"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["prebuild", "^build"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/blogs",
        "browser": "apps/blogs/src/main.ts",
        "index": "apps/blogs/src/index.html",
        "server": "apps/blogs/src/main.server.ts",
        "outputMode": "static",
        "tsConfig": "apps/blogs/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/blogs/public"
          },
          {
            "glob": "**/*",
            "input": "node_modules/layers-ui/fonts",
            "output": "/assets/layers-ui/fonts"
          }
        ],
        "styles": ["node_modules/layers-ui/layers.min.css", "apps/blogs/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "baseHref": "/blogs/",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "300kb",
              "maximumError": "350kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "postbuild": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/blogs/scripts/postbuild.mjs"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": ["prebuild:dev"],
      "defaultConfiguration": "development",
      "options": {
        "port": 4203
      },
      "configurations": {
        "production": {
          "buildTarget": "blogs:build:production"
        },
        "development": {
          "buildTarget": "blogs:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "implicitDependencies": ["tokens", "ui"]
}
