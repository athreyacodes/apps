{
  "name": "hosting",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/hosting",
  "projectType": "application",
  "implicitDependencies": ["shell", "weather", "markets"],
  "targets": {
    "assemble": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["shell", "weather", "markets"],
          "target": "build"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/hosting"],
      "options": {
        "command": "node tools/hosting/assemble.mjs"
      }
    }
  }
}
